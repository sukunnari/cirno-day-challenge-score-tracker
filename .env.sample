# To generate your own client id & secret,
# go to https://osu.ppy.sh/home/account/edit
# then scroll down to "OAuth" section
# and click "New OAuth Application"
OSU_OWN_CLIENT_ID=
OSU_OWN_CLIENT_SECRET=

# Website configuration
SERVER_PORT=3000
DB_URL="cirno.db"

# Retrieve the id from your room's url
# https://osu.ppy.sh/multiplayer/rooms/<your_room_id>
ROOM_ID=

# Management api
MANAGE_PASSWORD=